{
  "name": "photominder",
  "private": true,
  "version": "0.3.0",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron:build": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "exifreader": "4.33.1",
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "@google/genai": "^1.33.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.photominder.app",
    "productName": "PhotoMinder",
    "asar": true,
    "asarUnpack": [
      "node_modules/libheif-js/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "logger.cjs",
      "dist/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/{test,tests,__tests__,spec,docs,example,examples,benchmark}/**",
      "!**/node_modules/.package-lock.json"
    ],
    "afterPack": "build/afterPack.js",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
