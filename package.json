{
  "name": "photominder",
  "private": true,
  "version": "0.6.0",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "electron:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron:build": "npm run build && electron-builder && node build/recompressDmg.js",
    "dist:mac": "npm run build && electron-builder --mac --arm64 && node build/recompressDmg.js"
  },
  "dependencies": {
    "exifreader": "^4.45.0",
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.photominder.app",
    "productName": "PhotoMinder",
    "asar": true,
    "asarUnpack": [
      "node_modules/libheif-js/**/*"
    ],
    "files": [
      "electron/**/*",
      "dist/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.d.ts",
      "!**/{test,tests,__tests__,spec,docs,example,examples,benchmark}/**",
      "!**/node_modules/.package-lock.json",
      "!node_modules/exifreader/{src,bin}/**",
      "!node_modules/exifreader/babel.config.json",
      "!node_modules/libheif-js/libheif/**",
      "!node_modules/libheif-js/wasm.js",
      "!node_modules/libheif-js/libheif-wasm/{libheif.js,libheif.wasm,libheif-bundle.mjs}"
    ],
    "afterPack": "build/afterPack.js",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
